# 硬性条件：Node.js 22+、可写存档目录。下面有默认值，本机可全部留空。
# 外部/云访问 HOST=0.0.0.0 时，PET_ACCESS_PASSWORD 必填（至少12字符）。
HOST=127.0.0.1
PORT=3210
PET_DATA_DIR=./data
PET_ACCESS_PASSWORD=

# 选填昵称，不需要真实姓名、年龄、生日或照片。
PET_OWNER_NICKNAME=

# 以下全部选配；不填仍能讲文字故事、做菜、喂食和两次预制进化。
# 聊天/转文字/发声可用共享 key，也可以各自配置。
PET_AI_API_KEY=
PET_AI_BASE_URL=https://api.openai.com/v1
PET_CHAT_API_KEY=
PET_CHAT_BASE_URL=
PET_CHAT_MODEL=gpt-4o-mini
PET_ASR_API_KEY=
PET_ASR_BASE_URL=
PET_ASR_PROVIDER=openai
PET_ASR_MODEL=whisper-1
PET_TTS_API_KEY=
PET_TTS_BASE_URL=
PET_TTS_PROVIDER=openai
PET_TTS_MODEL=tts-1
PET_TTS_VOICE=nova

# 看图使用百炼原生接口，不能假设共享 key 或其他提供商 key 可用。
PET_VISION_API_KEY=
PET_VISION_BASE_URL=
PET_VISION_MODEL=qwen3-vl-plus

# 收费图片生成默认关闭。只填 key 不会开启额外图片生成。
PET_ENABLE_GENERATION=0
PET_IMAGE_API_KEY=
PET_IMAGE_BASE_URL=
PET_IMAGE_MODEL=gpt-image-2
PET_IMAGE_PYTHON=
PET_IMAGE_CLI=
PET_IMAGE_FFMPEG=

# 旅行需聊天+看图+图片生成，默认关闭；声音另需 TTS。
PET_ENABLE_TRIPS=0
PET_DISABLE_TRIPS=1
